tle_letterspace":"0","text":"<p>تحتاج آلة تطبيق البوتيل إلى مشغّل واحد. في البداية، يضع المشغّل الفاصل المثني على السير الناقل الصغير المتحرك الموجود على الآلة.<br />بعد ذلك، يتحرك الفاصل بسرعة محددة باتجاه فوهات حقن مادة البوتيل. وتوجد بالقرب من فتحات الفوهات مستشعرات تكشف وجود الفاصل، ثم ترسل إشارة إلى الآلة لبدء ضخ مادة البوتيل اللاصقة.<br />تستمر عملية تطبيق المادة اللاصقة ما دام المستشعر يكتشف وجود الفاصل أمامه، وتتوقف بمجرد انتهاء مرور الفاصل أمام المستشعر.<br />يكرر المشغّل هذه العملية مع بقية أضلاع الفاصل المثني، بحيث تُطبّق المادة اللاصقة على جانبي كل ضلع. وبمساعدة هذه الآلة متعددة الاستخدامات، يمكن أيضاً تطبيق المادة اللاصقة على الفواصل متعددة الأضلاع والدائرية. ومع ذلك، فإن تطبيق المادة اللاصقة على الفواصل المثنية بشكل دائري أكثر صعوبة. ولهذا، تُجهز الطرازات الأكثر تطوراً ببكرات تسهّل تطبيق المادة اللاصقة على الفواصل الدائرية.<br />لذلك، إذا كانت لديك طلبات خاصة كثيرة تتطلب ثني الفواصل بشكل دائري، فاحرص على الانتباه إلى هذه الميزة الصغيرة والمهمة.</p>","alignment":"","text_fontsize":{"md":"13","sm":"","xs":""},"text_lineheight":"","text_fontweight":"","dropcap":0,"class":"","global_background_type":"none","global_background_gradient":{"color":"#00c6fb","color2":"#005bea","deg":"45","type":"linear"},"global_background_image":{"src":""},"global_background_repeat":"no-repeat","global_background_size":"cover","global_background_attachment":"inherit","global_background_position":"50% 50%","global_use_overlay":0,"global_overlay_type":"overlay_none","global_gradient_overlay":{"color":"rgba(127, 0, 255, 0.8)","color2":"rgba(225, 0, 255, 0.7)","deg":"45","type":"linear"},"global_pattern_overlay":{"src":""},"global_overlay_pattern_color":"","blend_mode":"normal","global_user_border":0,"global_border_width":"","global_border_radius":0,"global_margin":{"md":"0px 0px 30px 0px","sm":"0px 0px 20px 0px","xs":"0px 0px 10px 0px"},"global_padding":{"md":"   ","sm":"   ","xs":"   "},"global_boxshadow":"0 0 0 0 #ffffff","global_use_animation":0,"global_animationduration":"300