":"#005bea","deg":"45","type":"linear"},"background_image":{"src":""},"background_repeat":"no-repeat","background_size":"cover","background_attachment":"scroll","background_position":"0 0","overlay_type":"overlay_color","gradient_overlay":{"color":"rgba(127, 0, 255, 0.8)","color2":"rgba(225, 0, 255, 0.7)","deg":"45","type":"linear"},"pattern_overlay":{"src":""},"overlay_pattern_color":"","blend_mode":"normal","items_align_center":0,"items_content_alignment":"center","use_border":0,"border_width":"","border_radius":0,"boxshadow":"0 0 0 0 #fff","sm_col":"col-sm-6","xs_col":"","tablet_order":"","mobile_order":"","hidden_xs":0,"hidden_sm":0,"hidden_md":0,"animationduration":"4000","animationdelay":"0","padding":{"md":"   ","sm":"   ","xs":"   "},"margin":{"md":"   ","sm":"   ","xs":"   "},"background":"#f0f7f7","color":"","animation":"bounceInLeft"},"addons":[{"id":1591877961844,"name":"text_block","visibility":true,"settings":{"admin_label":"","title":"ما هي آلة تطبيق البوتيل؟","heading_selector":"h2","title_fontsize":"","title_lineheight":"","title_letterspace":"0","text":"<p style=\"text-align: right;\">تتكون وحدة الزجاج المزدوج من لوحين أو أكثر من الزجاج، مرتبة بشكل متوازٍ وعلى مسافات متساوية، ويفصل بينها فاصل يحيط بمحيطها. وفي خط إنتاج النوافذ ذات الزجاج المزدوج، تُستخدم مادة البوتيل اللاصقة بوصفها مادة الإحكام الأولية لربط الفاصل بالزجاج.<br />ومن الشروط المهمة لهذا الربط أن تكون المنطقة المحيطة بالزجاج، أي موضع التلامس بين الزجاج والفاصل، محكمة وقوية. ويجب أن يحافظ هذا الربط على تماسكه حتى تطبيق مادة الإحكام الثانوية، المعروفة أيضاً باسم مادة البولي سلفايد. لذلك، فإن استخدام آلة تطبيق البوتيل أمر ضروري.<br />ومن الجدير بالذكر أن سرعة تطبيق المادة اللاصقة باستخدام هذه الآلة قد تصل إلى 50 متراً في الدقيقة، مما يزيد معدل إنتاج الزجاج المزدوج ويرفع مستوى الربحية.</p>","alignment":"","text_fontsize":{"md":"13","sm":"","xs":""},"text_lineheight":"","text_fontweight":"","dropcap":0,"class":"","global_background_type":"none","global_background_gradient":{"color":"#00c6fb