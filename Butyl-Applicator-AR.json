f","bottom_shape_width":{"md":"100","sm":100,"xs":100},"bottom_shape_height":{"md":"111","sm":"","xs":""},"bottom_shape_flip":false,"bottom_shape_invert":false,"bottom_shape_to_front":0,"hidden_xs":0,"hidden_sm":0,"hidden_md":0,"animationduration":"300","animationdelay":"0","background_color":"#f0f7f7","color":"#424A4F","instFormId":1591849370916,"row_border_width":{"md":"   ","sm":"   ","xs":"   "}},"layout":"12","columns":[{"id":1591877961852,"class_name":"col-md-12","visibility":true,"settings":{"background_type":"none","background_gradient":{"color":"#00c6fb","color2":"#005bea","deg":"45","type":"linear"},"background_image":{"src":""},"background_repeat":"no-repeat","background_size":"cover","background_attachment":"scroll","background_position":"0 0","overlay_type":"overlay_color","gradient_overlay":{"color":"rgba(127, 0, 255, 0.8)","color2":"rgba(225, 0, 255, 0.7)","deg":"45","type":"linear"},"pattern_overlay":{"src":""},"overlay_pattern_color":"","blend_mode":"normal","items_align_center":0,"items_content_alignment":"center","use_border":0,"border_width":"","border_radius":0,"boxshadow":"0 0 0 0 #fff","sm_col":"","xs_col":"","tablet_order":"","mobile_order":"","hidden_xs":"","hidden_sm":"","hidden_md":"","animationduration":"4000","animationdelay":"0","padding":{"md":"   ","sm":"   ","xs":"   "},"margin":{"md":"   ","sm":"   ","xs":"   "},"background":"#f0f7f7","color":"","animation":"bounceInUp"},"addons":[{"id":1591877961853,"name":"text_block","visibility":true,"settings":{"admin_label":"","title":"ميزات آلة تطبيق البوتيل","heading_selector":"h2","title_fontsize":"","title_lineheight":"","title_letterspace":"0","text":"تستطيع آلات تطبيق البوتيل عادةً وضع المادة اللاصقة على الفواصل التي يتراوح عرضها بين 6 و24 مم. كما يجب ضبط فوهات حقن المادة اللاصقة بما يتناسب مع عرض الفاصل.<br />يجري المشغّل هذه الضبطات باستخدام دواسة القدم. ويجب أن تتمكن الآلة أيضاً من ضبط المسافة بين الفوهات بشكل صحيح لتناسب الفواصل ذات الارتفاعات المختلفة. ويتراوح مدى ضبط ارتفاع الفوهة عادةً بين 5 و12 مم.<br />يتم تحديد سرعة الفاصل بواسطة السير الناقل الذي يستقر عليه الفاصل. وتتراوح السرعة في الطرازات المختلفة بين 5 و50 متراً في الدقيقة.<br />يرجى الانتباه إلى أن تشغيل الآلة بسرعات عالية (50 متراً في الدقيقة) قد يؤدي إلى انخفاض جودة المادة اللاصقة المطبقة.<br />لذلك، يُنصح بعدم تشغيل آلة تطبيق البوتيل باستمرار عند أقصى طاقتها، حتى لا تتراجع جودة التطبيق، ولا سيما من حيث كمية المادة اللاصقة الموزعة وانتظامها.<br />تُعد سعة خزان البوتيل من المواصفات المهمة الأخرى لآلة تطبيق البوتيل الخاصة بالزجاج المزدوج. وتبلغ سعة الخزانات في الآلات المتوفرة في السوق حالياً نحو 7 إلى 8 لترات.<br />كما ينبغي تسخين الخزان بانتظام وبشكل أوتوماتيكي باستخدام مؤقت يتحكم فيه نظام PLC الخاص بالآلة. ويجب أيضاً إتاحة إمكانية تعديل الفترات الزمنية لتسخين المادة اللاصقة من قبل المستخدم.<br />ومن الميزات الأخرى لآلات تطبيق البوتيل استخدام مستشعرات لتحديد مستوى المادة اللاصقة داخل الخزان.<br />يجب أن تعرض الآلة مستوى المادة اللاصقة باستمرار على شاشة العرض، حتى تتم إعادة تعبئة الخزان قبل أن يفرغ تماماً. ومن الأفضل أيضاً عرض ضغط حقن مادة البوتيل.<br />ومن الخيارات الإضافية إمكانية ضبط ارتفاع الآلة لتوفير الراحة للمشغّل. ويمكن أن يتراوح الارتفاع القابل للضبط بين 650 و950 مم عن سطح الأرض، بحيث يضبطه المشغّل وفقاً لطوله، مما يقلل التعب إلى أدنى حد.","alignment":"","text_fontsize":{"md":"13","sm":"","xs":""},"text_lineheight":"","text_fontweight":"","dropcap":0,"class":"","global_background_type":"none","global_background_gradient":{"color":"#00c6fb","color2":"#005bea","deg":"45","type":"linear"},"global_background_image":{"src":""},"global_background_repeat":"no-repeat","global_background_size":"cover","global_background_attachment":"inherit","global_background_position":"50% 50%","global_use_overlay":0,"global_overlay_type":"overlay_none","global_gradient_overlay":{"color":"rgba(127, 0, 255, 0.8)","color2":"rgba(225, 0, 255, 0.7)","deg":"45","type":"linear"},"global_pattern_overlay":{"src":""},"global_overlay_pattern_color":"","blend_mode":"normal","global_user_border":0,"global_bor