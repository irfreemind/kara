ern_color":"","blend_mode":"normal","items_align_center":0,"items_content_alignment":"center","use_border":0,"border_width":"","border_radius":0,"boxshadow":"0 0 0 0 #fff","sm_col":"","xs_col":"","tablet_order":"","mobile_order":"","hidden_xs":"","hidden_sm":"","hidden_md":"","animationduration":"4000","animationdelay":"0","padding":{"md":"   ","sm":"   ","xs":"   "},"margin":{"md":"   ","sm":"   ","xs":"   "},"background":"#f0f7f7","color":"","animation":"bounceInUp"},"addons":[{"id":1591877961853,"name":"text_block","visibility":true,"settings":{"admin_label":"","title":"مشخصات فنی و ویژگی های دستگاه تزریق سیلیکاژل\n","heading_selector":"h2","title_fontsize":"","title_lineheight":"","title_letterspace":"0","text":"شایان ذکر است که ابعاد اسپیسری که دستگاه قابلیت تزریق ماده رطوبت گیر به داخل آن را دارد، می تواند از حداقل 250 میلی متر تا حداکثر 2000 میلی متر باشد.<br />معمولاً دستگاه سیلیکاژل پرکن، قابلیت تنظیم ارتفاع را نیز داراست. به این صورت که برای پرکردن اسپیسرهای بلند، هد دستگاه توسط یک سیلندر پنوماتیکی در ارتفاع حرکت می کند تا عملیات پر کردن سیلیکاژل در اسپیسر به راحتی انجام شود.<br />علاوه بر این، پهنای اسپیسر نیز می تواند از 6 تا 32 میلی متر متغیر باشد.<br />مخزن سیلیکاژل دستگاه تزریق رطوبت گیر باید مجهر به المنت باشد تا از گرفتن رطوبت هوا توسط سیلیکاژل ممانعت گردد.<br />همچنین سیستم کنترل دستگاه نیز باید به صورت دوره ای (تایمردار) مخزن را گرم کرده و آن را در یک دمای خاص نگه دارد تا از عدم نفوذ سیلیکاژل به درون آن اطمینان کافی حاصل شود.<br />باید گفت که در دستگاه های تزریق سیلیکاژل اتوماتیک، با استفاده از ویبراتور می توان مقدار بیشتری ماده رطوبت گیر به درون اسپیسر تزریق کرد.<br />این مورد به عنوان یک آپشن کاربردی و مهم در بعضی از دستگاه های سیلیکاژل پرکن نیمه اتوماتیک هم دیده می شود.<br />پیشنهاد ما استفاده از دستگاه تزریق سیلیکاژل با این ویژگی می باشد. چرا که در طول زمان، امکان تقلیل یافتن میزان رطوبت جذب شده توسط سیلیکاژل وجود دارد و در صورتی که سیلیکاژل با تراکم بالا تزریق شده باشد، آنگاه کیفیت شیشه دوجداره در طول زمان تضمین می شود.<br />از سایر خصوصیات و مشخصات فنی دستگاه تزریق نم گیر می توان به موارد ذیل اشاره کرد:<br />جهت بالا بردن ظرفیت تولید از طریق پر کردن بیش از 20 اسپیسر به صورت همزمان<br />تکفاز و کم مصرف<br />دارای مخزن با ظرفیت 25 کیلو<br />استفاده از قطعات درجه یک استاندارد<br />رنگ آمیزی شده با سیستم رنگ کوره ای پودری الکترواستاتیک<br />دارای گارانتی طلایی سه ستاره به مدت 18ماه<br />دارای خدمات پس از فروش و تامین قطعات و لوازم یدکی به مدت 360 ماه","alignment":"","text_fontsize":{"md":"13","sm":"","xs":""},"text_lineheight":"","text_fontweight":"","dropcap":0,"class":"","global_background_type":"none","global_background_gradient":{"color":"#00c6fb","color2":"#005bea","deg":"45","type":"linear"},"global_background_image":{"src":""},"global_background_repeat":"no-repeat","global_background_size":"cover","global_background_attachment":"inherit","global_background_position":"50% 50%","global_use_overlay":0,"global_overlay_type":"overlay_none","global_gradient_overlay":{"color":"rgba(127, 0, 255, 0.8)","color2":"rgba(225, 0, 255, 0.7)","deg":"45","type":"linear"},"global_pattern_overlay":{"src":""},"global_overlay_pattern_color":"","blend_mode":"normal","global_user_border":0,"global_border_width":"","global_border_radius":0,"global_margin":{"md":"0px 0px 30px 0px","sm":"0px 0px 20px 0px","xs":"0px 0px 10px 0px"},"global_padding":{"md":"   ","sm":"   ","xs":"   "},"global_boxshadow":"0 0 0 0 #ffffff","global_use_animation":0,"global_animationduration":"300","global_animationdelay":"0","global_custom_css":"","global_custom_position":0,"global_seclect_position":"relative","global_addon_position_left":{"unit":"px"},"global_addon_position_top":{"unit":"px"},"use_global_width":"0","hidden_md":"0","hidden_sm":"0","hidden_xs":"0","acl":"","while_scroll_view":[{"enable_while_scroll_view":0,"on_scroll_actions":[{"id":"b3fdc1c1e6bfde5942ea","index":0,"keyframe":0,"name":"move","property":{"x":"0","y":"-100","z":"0"},"range":{"max":500,"min":-500,"stop":1},"single":true,"title":"Move"},{"id":"936e0225e6dc8edfba7d","ind