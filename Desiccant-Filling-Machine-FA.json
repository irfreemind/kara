":100,"xs":100},"bottom_shape_height":{"md":"111","sm":"","xs":""},"bottom_shape_flip":false,"bottom_shape_invert":false,"bottom_shape_to_front":0,"hidden_xs":0,"hidden_sm":0,"hidden_md":0,"animationduration":"300","animationdelay":"0","background_color":"#dfeeee","color":"#424A4F","instFormId":1591849370916,"row_border_width":{"md":"   ","sm":"   ","xs":"   "}},"layout":"12","columns":[{"id":1591877961843,"class_name":"col-md-12","visibility":true,"settings":{"background_type":"none","background_gradient":{"color":"#00c6fb","color2":"#005bea","deg":"45","type":"linear"},"background_image":{"src":""},"background_repeat":"no-repeat","background_size":"cover","background_attachment":"scroll","background_position":"0 0","overlay_type":"overlay_color","gradient_overlay":{"color":"rgba(127, 0, 255, 0.8)","color2":"rgba(225, 0, 255, 0.7)","deg":"45","type":"linear"},"pattern_overlay":{"src":""},"overlay_pattern_color":"","blend_mode":"normal","items_align_center":0,"items_content_alignment":"center","use_border":0,"border_width":"","border_radius":0,"boxshadow":"0 0 0 0 #fff","sm_col":"col-sm-6","xs_col":"","tablet_order":"","mobile_order":"","hidden_xs":0,"hidden_sm":0,"hidden_md":0,"animationduration":"4000","animationdelay":"0","padding":{"md":"   ","sm":"   ","xs":"   "},"margin":{"md":"   ","sm":"   ","xs":"   "},"background":"#f0f7f7","color":"","animation":"bounceInLeft"},"addons":[{"id":1591877961844,"name":"text_block","visibility":true,"settings":{"admin_label":"","title":"ضرورت دستگاه تزریق رطوبت گیر شیشه دوجداره","heading_selector":"h2","title_fontsize":"","title_lineheight":"","title_letterspace":"0","text":"<p>بخار بین دو شیشه در پنجره های دوجداره بعد از نصب آن، نشان دهنده کیفیت پایین ساخت محصول است که این موضوع از آزار دهنده ترین مشکلات حین نصب پنجره دوجداره محسوب می شود.<br />علت اصلی وجود بخار بین دو شیشه در پنجره دوجداره، عدم وجود ماده رطوبت گیر (سیلیکاژل) به میزان کافی در داخل اسپیسر آلومینیومی بین دو شیشه است.<br />همچنین نبود شیار تخلیه آب باران (راه آب باران) یا طراحی غیر استاندارد شیشه، از دلایل دیگر این موضوع می باشد.<br />بدین منظور در خط تولید شیشه های دوجداره جهت جلوگیری از بخار گرفتن شیشه، درون اسپیسر آلومینیومی را از مواد رطوبت گیر پر می کنند.<br />این فرآیند قبل از عملیات چسب بوتیل زنی، توسط دستگاه تزریق سیلیکاژل یا همان رطوبت گیر شیشه دوجداره انجام می گیرد.<br />در صورتی که سیلیکاژل در محل مناسب نگهداری شود (محلی که سیلیکاژل در مجاورت هوا قرار نداشته و رطوبت هوا را جذب نکرده باشد) و همچنین فرایند تزریق سیلیکاژل به درستی انجام شود یعنی اینکه مواد به میزان کافی در تمام طول اسپیسر تزریق گردد، آنگاه می توان اطمینان حاصل کرد که احتمال بخار بین دو شیشه تا حد بسیار خوبی، نزدیک به صفر کاهش یافته است.<br />جهت اطمینان از کیفیت انجام این عمل، از دستگاه تزریق سیلیکاژل استفاده می شود. با استفاده از این دستگاه، مواد رطوبت گیر در تمام طول اسپیسر به صورت یکنواخت و با تراکم مناسب پخش شده تا دغدغه مشکلات بخار شیشه به حداقل برسد.<br />این کیفیت کار فوق العاده، باعث می شود تا اکثر کارگاه های تولید شیشه دوجداره اقدام به خرید دستگاه تزریق سیلیکاژل کنند تا بتوانند رضایت مشتری را بهتر جلب نمایند و نرخ فروش خود را افزایش دهند.</p>","alignment":"","text_fontsize":{"md":"13","sm":"","xs":""},"text_lineheight":"","text_fontweight":"","dropcap":0,"class":"","global_background_type":"none","global_background_gradient":{"color":"#00c6fb","color2":"#005bea","deg":"45","type":"linear"},"global_background_image":{"src":""},"global_background_repeat":"no-repeat","global_background_size":"cover","global_background_attachment":"inherit","global_background_position":"50% 50%","global_use_overlay":0,"global_overlay_type":"overlay_none","global_gradient_overlay":{"color":"rgba(127, 0, 255, 0.8)","color2":"rgba(225, 0, 255, 0.7)","deg":"45","type":"linear"},"global_pattern_overlay":{"src":""},"global_overlay_pattern_color":"","blend_mode":"normal","global_user_border":0,"global_border_width":"","global_border_radius":0,"global_margin":{"md":"0px 0px 30px 0px","sm":"0px 0px 20px 0px","xs":"0px 0px 10px 0px"},"global_padding":{"md":"   ","sm":