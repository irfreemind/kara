on":"bounceInLeft"},"addons":[{"id":1633713458069,"name":"text_block","visibility":true,"settings":{"admin_label":"","title":"معرفی بهترین دستگاه بوتیل زن شیشه دوجداره","heading_selector":"h2","title_fontsize":"","title_lineheight":"","title_letterspace":"0","text":"<p>همانطور که متوجه شدید استفاده از دستگاه های بوتیل زن در پروسه تولید شیشه دوجداره ضروری می باشد.<br />در صورتی که عملیات چسب زنی به صورت دستی انجام گیرد، به دلیل عدم دقت در میزان چسب و یکنواختی آن در سطح اسپیسر، کیفیت و تمیزی کار بسیار پایین می آید.<br />با این تفاسیر پیشنهاد می کنیم که حتماً دستگاه را از برترین تولید کنندگان ایرانی خریداری کنید تا با خیال راحت از سرمایه گذاری خود در صنعت تولید شیشه دوجداره نتیجه بگیرید.<br />این دستگاه ها دارای مشخصات ذیل می باشند:<br />• قابلیت بوتیل زنی دو طرفه اسپیسر<br />• مجهز به سنسور قطع و وصل بوتیل زنی بر مبنای ورود و خروج اسپیسر<br />• سیستم دستگاه به صورت الکتروپنوماتیک و هیدرولیک<br />• استفاده از قطعات درجه یک استاندارد<br />• رنگ آمیزی شده با سیستم رنگ کوره ای پودری الکترواستاتیک<br />• دارای گارانتی طلایی سه ستاره به مدت 18ماه<br />• دارای خدمات پس از فروش و تامین قطعات و لوازم یدکی به مدت 360 ماه</p>","alignment":"","text_fontsize":{"md":"13","sm":"","xs":""},"text_lineheight":"","text_fontweight":"","dropcap":0,"class":"","global_background_type":"none","global_background_gradient":{"color":"#00c6fb","color2":"#005bea","deg":"45","type":"linear"},"global_background_image":{"src":""},"global_background_repeat":"no-repeat","global_background_size":"cover","global_background_attachment":"inherit","global_background_position":"50% 50%","global_use_overlay":0,"global_overlay_type":"overlay_none","global_gradient_overlay":{"color":"rgba(127, 0, 255, 0.8)","color2":"rgba(225, 0, 255, 0.7)","deg":"45","type":"linear"},"global_pattern_overlay":{"src":""},"global_overlay_pattern_color":"","blend_mode":"normal","global_user_border":0,"global_border_width":"","global_border_radius":0,"global_margin":{"md":"0px 0px 30px 0px","sm":"0px 0px 20px 0px","xs":"0px 0px 10