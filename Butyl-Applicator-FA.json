shape_height":{"md":"120","sm":"","xs":""},"shape_flip":0,"shape_invert":0,"shape_to_front":1,"show_bottom_shape":0,"bottom_shape_name":"zigzag-sharp","bottom_shape_color":"#ffffff","bottom_shape_width":{"md":"100","sm":100,"xs":100},"bottom_shape_height":{"md":"111","sm":"","xs":""},"bottom_shape_flip":false,"bottom_shape_invert":false,"bottom_shape_to_front":0,"hidden_xs":0,"hidden_sm":0,"hidden_md":0,"animationduration":"300","animationdelay":"0","background_color":"#f0f7f7","color":"#424A4F","instFormId":1591849370916,"row_border_width":{"md":"   ","sm":"   ","xs":"   "}},"layout":"12","columns":[{"id":1591877961852,"class_name":"col-md-12","visibility":true,"settings":{"background_type":"none","background_gradient":{"color":"#00c6fb","color2":"#005bea","deg":"45","type":"linear"},"background_image":{"src":""},"background_repeat":"no-repeat","background_size":"cover","background_attachment":"scroll","background_position":"0 0","overlay_type":"overlay_color","gradient_overlay":{"color":"rgba(127, 0, 255, 0.8)","color2":"rgba(225, 0, 255, 0.7)","deg":"45","type":"linear"},"pattern_overlay":{"src":""},"overlay_pattern_color":"","blend_mode":"normal","items_align_center":0,"items_content_alignment":"center","use_border":0,"border_width":"","border_radius":0,"boxshadow":"0 0 0 0 #fff","sm_col":"","xs_col":"","tablet_order":"","mobile_order":"","hidden_xs":"","hidden_sm":"","hidden_md":"","animationduration":"4000","animationdelay":"0","padding":{"md":"   ","sm":"   ","xs":"   "},"margin":{"md":"   ","sm":"   ","xs":"   "},"background":"#f0f7f7","color":"","animation":"bounceInUp"},"addons":[{"id":1591877961853,"name":"text_block","visibility":true,"settings":{"admin_label":"","title":"ویژگی های دستگاه چسب بوتیل زن","heading_selector":"h2","title_fontsize":"","title_lineheight":"","title_letterspace":"0","text":"معمولاً دستگاه چسب بوتیل، توانایی چسب زدن اسپیسر با پهنای 6 تا 24 میلی متر را دارا می باشند. همچنین نازل های تزریق چسب باید بر اساس پهنای اسپیسر تنظیم گردند.<br />این تنظیمات به کمک پدال پا توسط اپراتور انجام می گیرد. عملیات تنظیم فاصله نازل برای اسپیسر با ارتفاع متفاوت نیز باید به درستی توسط دستگاه انجام شود. این تنظیم معمولاً 5 تا 12 میلی متر ارتفاع نازل را تغییر می دهد.<br />همینطور سرعت اسپیسر توسط نوار نقاله (کانوایر) که اسپیسر بر روی آن قرار دارد، انتخاب می شود و در دستگاه های مختلف این عدد بین 5 تا 50 متر بر دقیقه متغیر است.<br />توجه داشته باشید در صورتی که سرعت های بالا (50 متر بر دقیقه) توسط کاربر به دستگاه داده شود، امکان افت کیفیت چسب تزریق شده توسط دستگاه وجود دارد.<br />لذا توصیه می شود در هنگام استفاده از دستگاه بوتیل زن از توان حداکثری آن استفاده نشود تا کیفیت چسب زنی (منظور مقدار و یکنواختی چسب تزریق شده) افت پیدا نکند.<br />ظرفیت مخزن چسب بوتیل از دیگر مشخصات دستگاه بوتیل چسب زن شیشه دوجداره است. ظرفیت مخزن در دستگاه های موجود در بازار تقریباً 7 تا 8 لیتر می باشد.<br />همچنین مخزن باید توسط سیستم کنترل PLC دستگاه به صورت منظم و اتوماتیک (تایمردار) گرم شود. همینطور باید امکان تغییر بازه های زمانی گرم شدن چسب توسط کاربر مهیا گردد.<br />از ویژگی های دیگر دستگاه های بوتیل زن، استفاده از سنسورهای تعیین سطح چسب در مخزن چسب می باشد.<br />دستگاه باید به صورت پیوسته ارتفاع سطح چسب در مخزن را توسط نمایشگر نشان دهد تا قبل از خالی شدن کامل، پر کردن مجدد مخزن چسب انجام شود. همچنین بهتر است فشار تزریق چسب بوتیل نیز نشان داده شود.<br />از دیگر آپشن های این دستگاه می توان به امکان تنظیم ارتفاع برای راحتی اپراتور اشاره کرد. این ارتفاع می تواند بین 650 تا 950 میلی متر از سطح زمین متغیر باشد تا اپراتور بسته به قد خود آن را تنظیم کرده، در این صورت خستگی وی به حداقل ممکن می رسد.","alignment":"","text_fontsize":{"md":"13","sm":"","xs":""},"text_lineheight":"","text_fontweight":"","dropcap":0,"class":"","global_background_type":"none","global_background_gradient":{"color":"#00c6fb","color2":"#005bea","deg":"45","type":"linear"},"global_background_image":{"src":""},"global_background_repeat":"no-repeat","global_background_size":"cover","global_background_attachment":"inherit","global_background_position":"50% 50%","global_use_