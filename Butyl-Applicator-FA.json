#005bea","deg":"45","type":"linear"},"background_image":{"src":""},"background_repeat":"no-repeat","background_size":"cover","background_attachment":"scroll","background_position":"0 0","overlay_type":"overlay_color","gradient_overlay":{"color":"rgba(127, 0, 255, 0.8)","color2":"rgba(225, 0, 255, 0.7)","deg":"45","type":"linear"},"pattern_overlay":{"src":""},"overlay_pattern_color":"","blend_mode":"normal","items_align_center":0,"items_content_alignment":"center","use_border":0,"border_width":"","border_radius":0,"boxshadow":"0 0 0 0 #fff","sm_col":"col-sm-6","xs_col":"","tablet_order":"","mobile_order":"","hidden_xs":0,"hidden_sm":0,"hidden_md":0,"animationduration":"4000","animationdelay":"0","padding":{"md":"   ","sm":"   ","xs":"   "},"margin":{"md":"   ","sm":"   ","xs":"   "},"background":"#f0f7f7","color":"","animation":"bounceInLeft"},"addons":[{"id":1591877961844,"name":"text_block","visibility":true,"settings":{"admin_label":"","title":"دستگاه بوتیل زن چیست؟","heading_selector":"h2","title_fontsize":"","title_lineheight":"","title_letterspace":"0","text":"<p style=\"text-align: right;\">سيستم شيشه دو جداره شامل دو يا چند لايه شيشه است که به طور موازی و در فواصل مساوی از يکديگر قرار گرفته و توسط اسپيسر در دور تا دور آن، از یکدیگر جدا شده اند. در خط تولید پنجره دوجداره به منظور اتصال اسپیسر شیشه دوجداره، از چسب بوتیل به عنوان چسب اولیه استفاده می کنند. <br />اما نکته مهم در اتصال اسپیسر به شیشه دوجداره این است که اطراف شیشه (محل تماس شیشه با اسپیسر) باید اتصال محکمی داشته باشد. این اتصال باید تا زمان زدن چسب ثانویه یا همان چسب پلی سولفاید، استحکام خود را حفظ نماید. بنابراین استفاده از دستگاه چسب بوتیل زن ضروری می باشد.<br />شایان ذکر است که سرعت چسب زدن توسط این دستگاه می تواند تا مرز 50 متر بر دقیقه نیز باشد که این موضوع باعث افزایش نرخ تولید شیشه دوجداره و سودآوری بیشتر می گردد.</p>","alignment":"","text_fontsize":{"md":"13","sm":"","xs":""},"text_lineheight":"","text_fontweight":"","dropcap":0,"class":"","global_background_type":"none","global_background_