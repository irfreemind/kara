"#00c6fb","color2":"#005bea","deg":"45","type":"linear"},"background_image":{"src":""},"background_repeat":"no-repeat","background_size":"cover","background_attachment":"scroll","background_position":"0 0","overlay_type":"overlay_color","gradient_overlay":{"color":"rgba(127, 0, 255, 0.8)","color2":"rgba(225, 0, 255, 0.7)","deg":"45","type":"linear"},"pattern_overlay":{"src":""},"overlay_pattern_color":"","blend_mode":"normal","items_align_center":0,"items_content_alignment":"center","use_border":0,"border_width":"","border_radius":0,"boxshadow":"0 0 0 0 #fff","sm_col":"col-sm-6","xs_col":"","tablet_order":"","mobile_order":"","hidden_xs":0,"hidden_sm":0,"hidden_md":0,"animationduration":"4000","animationdelay":"0","padding":{"md":"   ","sm":"   ","xs":"   "},"margin":{"md":"   ","sm":"   ","xs":"   "},"background":"#f0f7f7","color":"","animation":"bounceInLeft"},"addons":[{"id":1591877961844,"name":"text_block","visibility":true,"settings":{"admin_label":"","title":"What Is a Butyl Applicator?","heading_selector":"h2","title_fontsize":"","title_lineheight":"","title_letterspace":"0","text":"<p style=\"text-align: right;\">A double-glazed glass unit consists of two or more panes arranged parallel to one another at an equal distance and separated around their perimeter by a spacer. In double-glazed window production, butyl adhesive is used as the primary sealant to bond the spacer to the glass.<br />An important requirement for this bond is that the area around the glass, where the glass meets the spacer, must be firmly sealed. This bond must remain strong until the secondary sealant, also known as polysulfide sealant, is applied. This is why a butyl applicator is essential.<br />It is worth noting that this machine can apply adhesive at speeds of up to 50 metres per minute, increasing double-glazed glass production rates and profitability.</p>","alignment":"","text_fontsize":{"md":"13","sm":"","xs":""},"text_lineheight":"","text_fontweight":"","dropcap":0,"class":"","global_background_type":"none","global_background_gradient":{"color":"#00c6fb","color2":"#005bea","deg":"45","type":"linear"},"global_background_image":{"src":""},"global_background_repeat":"no-repeat","global_background_size":"cover","global_background_attachment":"inherit","global_background_position":"50% 50%","global_use_overlay":0,"global_overlay_type":"overlay_none","global_gradient_overlay":{"color":"rgba(127, 0, 255, 0.8)","color2":"rgba(225, 0, 255, 0.7)","deg":"45","type":"linear"},"global_pattern_overlay":{"src":""},"global_overlay_pattern_color":"","blend_mode":"normal","global_user_border":0,"global_border_width":"","global_border_radius":0,"global_margin":{"md":"0px 0px 30px 0px","sm":"0px 0px 20px 0px","xs":"0px 0px 10px 0px"},"global_padding":{"md":"   ","sm":"   ","xs":"   "},"global_boxshadow":"0 0 0 0 #ffffff","global_use_animation":0,"global_animationduration":"300","global_animationdelay":"0","global_custom_css":"","global_custom_position":0,"global_seclect_position":"relative","global_addon_position_left":{"unit":"px"},"global_addon_position_top":{"unit":"px"},"use_global_width":"0","hidden_md":"0","hidden_sm":"0","hidden_xs":"0","acl":"","while_scroll_view":[{"enable_while_scroll_view":0,"on_scroll_actions":[{"id":"b3fdc1c1e6bfde5942ea","index":0,"keyframe":0,"name":"move","property":{"x":"0","y":"-100","z":"0"},"range":{"max":500,"min":-500,"stop":1},"single":true,"title":"Move"},{"id":"936e0225e6dc8edfba7d","index":1,"keyframe":100,"name":"move","property":{"x":0,"y":0,"z":0},"range":{"max":500,"min":-500,"stop":1},"single":true,"title":"Move"}],"transition_origin_x":"center","transition_origin_y":"center","enable_tablet":0,"enable_mobile":0}],"mouse_movement":[{"enable_tilt_effect":0,"mouse_tilt_direction":"direct","mouse_tilt_speed":"1","mouse_tilt_max":"15","enable_tablet":0,"enable_mobile":0}],"instFormId":1591849370919}},{"id":1638345738007,"name":"text_block","visibility":true,"settings":{"admin_label":"","title":"How Does a Butyl Applicator Work?","heading_selector":"h2","title_fontsize":"","title_lineheight":"","title_letterspace":"0","text":"<p>Operating a butyl applicator requires one operator. First, the operator places the bent spacer bar on the small conveyor belt that moves along the machine.<br />The spacer then travels at a set speed towards the butyl injection nozzles. Sensors near the nozzle openings detect the presence of the spacer and trigger the machine to dispense butyl adhesive.<br />Adhesive application continues while the sensor detects the spacer in front of it. Once the spacer has passed the sensor, adhesive dispensing stops.<br />The operator repeats this process for the remaining sides of the bent spacer so that adhesive is applied to both sides of every section. This versatile machine can also apply adhesive to polygonal and circular spacers. However, applying adhesive to circularly bent spacers is more difficult. More advanced machines therefore include rollers that make it easier to apply adhesive to circular spacers.<br />If you frequently receive special orders that require circular spacer bending, be sure to pay attention to this small but important feature.</p>","alignment":"","text_fontsize":{"md":"13","sm":"","xs":""},"text_lineheight":"","text_fontweight":"","dropcap":0,"class":"","global_background_type":"none","global_background_gradient":{"color":"#00c6fb","color2":"#005bea","deg":"45","type":"linear"},"global_background_image":{"src":""},"global_background_repeat":"no-repeat","global_background_size":"cover","global_background_attachment":"inherit","global_background_position":"50% 50%","global_use_overlay":0,"global_overlay_type":"overlay_none","global_gradient_overlay":{"color":"rgba(127, 0, 255, 0.8)","color2":"rgba(225, 0, 255, 0.7)","deg":"45","type":"linear"},"global_pattern_overlay":{"src":""},"global_overlay_pattern_color":"","blend_mode":"normal","global_user_border":0,"global_border_width":"","global_border_radius":0,"global_margin":{"md":"0px 0px 