100","sm":100,"xs":100},"shape_height":{"md":"120","sm":"","xs":""},"shape_flip":0,"shape_invert":0,"shape_to_front":1,"show_bottom_shape":0,"bottom_shape_name":"zigzag-sharp","bottom_shape_color":"#ffffff","bottom_shape_width":{"md":"100","sm":100,"xs":100},"bottom_shape_height":{"md":"111","sm":"","xs":""},"bottom_shape_flip":false,"bottom_shape_invert":false,"bottom_shape_to_front":0,"hidden_xs":0,"hidden_sm":0,"hidden_md":0,"animationduration":"300","animationdelay":"0","background_color":"#f0f7f7","color":"#424A4F","instFormId":1591849370916,"row_border_width":{"md":"   ","sm":"   ","xs":"   "}},"layout":"12","columns":[{"id":1591877961852,"class_name":"col-md-12","visibility":true,"settings":{"background_type":"none","background_gradient":{"color":"#00c6fb","color2":"#005bea","deg":"45","type":"linear"},"background_image":{"src":""},"background_repeat":"no-repeat","background_size":"cover","background_attachment":"scroll","background_position":"0 0","overlay_type":"overlay_color","gradient_overlay":{"color":"rgba(127, 0, 255, 0.8)","color2":"rgba(225, 0, 255, 0.7)","deg":"45","type":"linear"},"pattern_overlay":{"src":""},"overlay_pattern_color":"","blend_mode":"normal","items_align_center":0,"items_content_alignment":"center","use_border":0,"border_width":"","border_radius":0,"boxshadow":"0 0 0 0 #fff","sm_col":"","xs_col":"","tablet_order":"","mobile_order":"","hidden_xs":"","hidden_sm":"","hidden_md":"","animationduration":"4000","animationdelay":"0","padding":{"md":"   ","sm":"   ","xs":"   "},"margin":{"md":"   ","sm":"   ","xs":"   "},"background":"#f0f7f7","color":"","animation":"bounceInUp"},"addons":[{"id":1591877961853,"name":"text_block","visibility":true,"settings":{"admin_label":"","title":"Features of a Butyl Applicator","heading_selector":"h2","title_fontsize":"","title_lineheight":"","title_letterspace":"0","text":"Butyl applicators typically apply adhesive to spacer bars with widths ranging from 6 to 24 mm. The adhesive injection nozzles must also be adjusted to match the spacer width.<br />The operator makes these adjustments using a foot pedal. The machine must also correctly adjust the distance between the nozzles to accommodate spacers of different heights. This adjustment typically changes the nozzle height by 5 to 12 mm.<br />The spacer speed is selected through the conveyor belt on which the spacer rests. Depending on the machine model, speeds range from 5 to 50 metres per minute.<br />Please note that operating the machine at high speeds (50 metres per minute) may reduce the quality of the applied adhesive.<br />We therefore recommend avoiding continuous operation at the machine's maximum capacity to prevent a decline in application quality, particularly in the amount and uniformity of the dispensed adhesive.<br />The butyl tank capacity is another important specification of a double-glazed glass butyl applicator. Tanks in machines currently available on the market typically hold approximately 7 to 8 litres.<br />The tank should also be heated regularly and automatically, using a timer controlled by the machine's PLC system. Users should be able to adjust the adhesive heating intervals.<br />Another useful feature of butyl applicators is the use of adhesive-level sensors in the tank.<br />The machine should continuously display the adhesive level on a screen so the tank can be refilled before it becomes completely empty. It is also preferable for the butyl injection pressure to be displayed.<br />An additional option is adjustable working height for operator comfort. The height may be adjustable from 650 to 950 mm above floor level, allowing operators to set it according to their height and minimise fatigue.","alignment":"","text_fontsize":{"md":"13","sm":"","xs":""},"text_lineheight":"","text_fontweight":"","dropcap":0,"class":"","global_background_type":"none","global_background_gradient":{"color":"#00c6fb","color2":"#005bea","deg":"45","type":"linear"},"global_background_image":{"src":""},"glob